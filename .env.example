# Copy to .env. Keep .env private; it is gitignored.
CLAUDE_CODE_OAUTH_TOKEN=
# Entra ID app registration for code-server sign-in (oauth2-proxy).
# Redirect URI: http://localhost:8080/oauth2/callback (platform: Web).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Jira Cloud for the Command Center extension (API token: id.atlassian.com → Security → API tokens).
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# GitHub token for git push and gh (fine-grained: Contents and Pull requests read/write).
GH_TOKEN=
