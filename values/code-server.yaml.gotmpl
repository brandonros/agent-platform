{{- $tag := index (readFile "../image-tags.yaml" | fromYaml) "code-server" -}}
{{- $id := trimPrefix "code-server-" .Release.Name -}}
{{- $user := index (readFile "../users.yaml" | fromYaml) $id -}}
# One release per user in users.yaml: code-server-<id>.
defaultPodOptions:
  securityContext: {runAsUser: 1000, runAsGroup: 1000, fsGroup: 1000}
  labels: {app: code-server, code-server-user: {{ $id | quote }}}
controllers:
  main:
    labels: {app: code-server}
    containers:
      app:
        image: {repository: code-server, tag: {{ $tag | quote }}, pullPolicy: IfNotPresent}
        # No password: sign-in is oauth2-proxy (Entra ID) in front; no ingress.
        args: ["--bind-addr", "0.0.0.0:8080", "--auth", "none", "/home/coder/workspace"]
        env:
          CLAUDE_CODE_OAUTH_TOKEN: {valueFrom: {secretKeyRef: {name: claude-secrets, key: oauth-token}}}
          GIT_AUTHOR_NAME: {{ $user.name | quote }}
          GIT_AUTHOR_EMAIL: {{ $user.email | quote }}
          GIT_COMMITTER_NAME: {{ $user.name | quote }}
          GIT_COMMITTER_EMAIL: {{ $user.email | quote }}
          # Command Center: ${userEmail} in JQL presets.
          COMMAND_CENTER_USER_EMAIL: {{ $user.email | quote }}
          # Command Center: ${githubUser} in pull request presets.
          COMMAND_CENTER_GITHUB_USER: {{ $user.github | default "" | quote }}
        # Command Center: JIRA_BASE_URL, JIRA_EMAIL, JIRA_API_TOKEN. Demo tickets without it.
        envFrom:
          - secretRef: {name: jira, optional: true}
          # GH_TOKEN: git push and gh.
          - secretRef: {name: github, optional: true}
        resources: {requests: {cpu: 250m, memory: 512Mi}, limits: {memory: 2Gi}}
persistence:
  # The user's PVC: workspace (ticket folders) and ~/.claude, plus sessions/<uuid>/
  # for Jobs. Mount only those so the CLI and extension under /home/coder stay visible.
  home:
    type: persistentVolumeClaim
    accessMode: ReadWriteOnce
    size: 10Gi
    globalMounts:
      - {path: /home/coder/workspace, subPath: workspace}
      - {path: /home/coder/.claude, subPath: claude}
service:
  main:
    controller: main
    ports:
      http: {port: 8080}
