{{- $tags := readFile "../image-tags.yaml" | fromYaml -}}
{{- $image := printf "claude-base:%s" (env "CLAUDE_BASE_IMAGE_TAG" | default (index $tags "claude-base")) -}}
# Job template for one Claude Code turn in the shared workspace. Dispatchers read
# it from the cluster and set metadata.name, labels, PROMPT, and SESSION_ID.
configMaps:
  template:
    forceRename: claude-job-template
    data:
      job.json: |
        {
          "apiVersion": "batch/v1",
          "kind": "Job",
          "metadata": {"labels": {"app": "claude-job"}},
          "spec": {
            "backoffLimit": 0,
            "activeDeadlineSeconds": 3600,
            "ttlSecondsAfterFinished": 86400,
            "template": {
              "metadata": {"labels": {"app": "claude-job"}},
              "spec": {
                "restartPolicy": "Never",
                "automountServiceAccountToken": false,
                "securityContext": {"runAsUser": 1000, "runAsGroup": 1000, "fsGroup": 1000},
                "containers": [{
                  "name": "claude",
                  "image": {{ $image | toJson }},
                  "imagePullPolicy": "IfNotPresent",
                  "workingDir": "/home/coder/workspace",
                  "command": ["sh", "-c", "f=\"$HOME/.claude/projects/-home-coder-workspace/$SESSION_ID.jsonl\"; if [ -f \"$f\" ]; then flag=--resume; else flag=--session-id; fi; exec claude -p \"$PROMPT\" --output-format json --permission-mode bypassPermissions \"$flag\" \"$SESSION_ID\""],
                  "env": [
                    {"name": "PROMPT", "value": ""},
                    {"name": "SESSION_ID", "value": ""},
                    {"name": "CLAUDE_CODE_ENTRYPOINT", "value": "claude-vscode"},
                    {"name": "CLAUDE_CODE_OAUTH_TOKEN", "valueFrom": {"secretKeyRef": {"name": "chat-secrets", "key": "oauth-token"}}}
                  ],
                  "resources": {"requests": {"cpu": "100m", "memory": "256Mi"}, "limits": {"memory": "1Gi"}},
                  "volumeMounts": [
                    {"name": "workspace", "mountPath": "/home/coder/workspace", "subPath": "workspace"},
                    {"name": "workspace", "mountPath": "/home/coder/.claude", "subPath": "claude"}
                  ]
                }],
                "volumes": [{"name": "workspace", "persistentVolumeClaim": {"claimName": "code-server"}}]
              }
            }
          }
        }
