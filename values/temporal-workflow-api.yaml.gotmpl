defaultPodOptions:
  automountServiceAccountToken: false
controllers:
  main:
    containers:
      app:
        image: {repository: python, tag: "3.12-slim"}
        command: [sh, -c, 'pip install --no-cache-dir --target=/tmp/deps fastapi==0.143.3 uvicorn==0.54.0 temporalio==1.34.0 && PYTHONPATH=/tmp/deps python -m uvicorn server:app --app-dir /app --host 0.0.0.0 --port 8000']
        env:
          TEMPORAL_ADDRESS: temporal-dev-server.chat.svc.cluster.local:7233
          WORKFLOW_API_TOKEN:
            valueFrom:
              secretKeyRef: {name: chat-secrets, key: api-key}
        resources:
          requests: {cpu: 20m, memory: 64Mi}
          limits: {memory: 256Mi}
        probes:
          readiness:
            enabled: true
            custom: true
            spec:
              tcpSocket: {port: 8000}
              periodSeconds: 5
configMaps:
  code:
    data:
      server.py: |
{{ readFile "../apps/temporal-workflow-api/server.py" | indent 8 }}
persistence:
  code:
    type: configMap
    identifier: code
    globalMounts: [{path: /app, readOnly: true}]
service:
  main:
    controller: main
    ports:
      http: {port: 8000}
ingress:
  main:
    className: traefik
    hosts:
      - host: workflows.127.0.0.1.sslip.io
        paths:
          - path: /
            pathType: Prefix
            service:
              identifier: main
              port: http
