controllers:
  {{ .Release.Name }}:
    forceRename: {{ .Release.Name }}
    # app-template's checksum/configMaps annotation rolls the pod on code changes.
    initContainers:
      # Stock image, no build: install dependencies into a shared emptyDir.
      deps:
        image: &python
          repository: python
          tag: "3.12-slim"
        command:
          - pip
          - install
          - --no-cache-dir
          - --target=/deps
          - temporalio==1.34.0
          - httpx==0.28.1
    containers:
      app:
        image: *python
        command: ["python", "/app/worker.py"]
        env:
          PYTHONPATH: /deps
          PYTHONUNBUFFERED: "1"
          TEMPORAL_ADDRESS: temporal-dev-server.chat.svc.cluster.local:7233
          WORKER_KIND: {{ if eq .Release.Name "temporal-meeting-notes-worker" }}meeting-notes{{ else }}draft-review{{ end }}
          MAX_CONCURRENT_ACTIVITIES: "4"
          WEBUI_URL: http://open-webui.chat.svc.cluster.local:8080
          WEBUI_EMAIL:
            valueFrom:
              secretKeyRef: {name: temporal-webui-login, key: email}
          WEBUI_PASSWORD:
            valueFrom:
              secretKeyRef: {name: temporal-webui-login, key: password}
        resources:
          limits:
            memory: 256Mi
          requests:
            cpu: 20m
            memory: 64Mi
    replicas: 1
configMaps:
  code:
    data:
      framework____init__.py: |
{{ readFile "../apps/temporal-workers/framework/__init__.py" | indent 8 }}
      framework__models.py: |
{{ readFile "../apps/temporal-workers/framework/models.py" | indent 8 }}
      framework__webui.py: |
{{ readFile "../apps/temporal-workers/framework/webui.py" | indent 8 }}
      worker.py: |
{{ readFile "../apps/temporal-workers/worker.py" | indent 8 }}
      workflows____init__.py: |
{{ readFile "../apps/temporal-workers/workflows/__init__.py" | indent 8 }}
      workflows__capabilities.py: |
{{ readFile "../apps/temporal-workers/workflows/capabilities.py" | indent 8 }}
      workflows__draft_review.py: |
{{ readFile "../apps/temporal-workers/workflows/draft_review.py" | indent 8 }}
      workflows__meeting_notes.py: |
{{ readFile "../apps/temporal-workers/workflows/meeting_notes.py" | indent 8 }}
persistence:
  deps:
    type: emptyDir
    globalMounts:
      - path: /deps
  code:
    type: configMap
    identifier: code
    items:
      - key: framework____init__.py
        path: framework/__init__.py
      - key: framework__models.py
        path: framework/models.py
      - key: framework__webui.py
        path: framework/webui.py
      - key: worker.py
        path: worker.py
      - key: workflows____init__.py
        path: workflows/__init__.py
      - key: workflows__capabilities.py
        path: workflows/capabilities.py
      - key: workflows__draft_review.py
        path: workflows/draft_review.py
      - key: workflows__meeting_notes.py
        path: workflows/meeting_notes.py
    globalMounts:
      - path: /app
