# Microsoft Entra ID sign-in in front of code-server (which runs with --auth none).
# Credentials come from the oauth2-proxy Secret created by `just secrets`.
defaultPodOptions:
  automountServiceAccountToken: false
controllers:
  main:
    containers:
      app:
        image: {repository: quay.io/oauth2-proxy/oauth2-proxy, tag: v7.15.5}
        env:
          ENTRA_TENANT_ID: {valueFrom: {secretKeyRef: {name: oauth2-proxy, key: tenant-id}}}
          OAUTH2_PROXY_PROVIDER: entra-id
          OAUTH2_PROXY_OIDC_ISSUER_URL: https://login.microsoftonline.com/$(ENTRA_TENANT_ID)/v2.0
          OAUTH2_PROXY_CLIENT_ID: {valueFrom: {secretKeyRef: {name: oauth2-proxy, key: client-id}}}
          OAUTH2_PROXY_CLIENT_SECRET: {valueFrom: {secretKeyRef: {name: oauth2-proxy, key: client-secret}}}
          OAUTH2_PROXY_COOKIE_SECRET: {valueFrom: {secretKeyRef: {name: oauth2-proxy, key: cookie-secret}}}
          OAUTH2_PROXY_SCOPE: openid email profile
          # Single-tenant app: any account in the tenant may sign in.
          OAUTH2_PROXY_EMAIL_DOMAINS: "*"
          OAUTH2_PROXY_UPSTREAMS: http://code-server.chat.svc.cluster.local:8080
          OAUTH2_PROXY_HTTP_ADDRESS: 0.0.0.0:4180
          # Reached through `just code-server` (port-forward to localhost:8080), so plain-HTTP cookies.
          OAUTH2_PROXY_REDIRECT_URL: http://localhost:8080/oauth2/callback
          OAUTH2_PROXY_COOKIE_SECURE: "false"
          OAUTH2_PROXY_SKIP_PROVIDER_BUTTON: "true"
        resources:
          requests: {cpu: 10m, memory: 32Mi}
          limits: {memory: 128Mi}
service:
  main:
    controller: main
    ports:
      http: {port: 4180}
